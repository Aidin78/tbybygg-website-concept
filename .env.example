# Canonical site URL used for metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://www.tbybygg.se

# Quote form (sent through Resend). Without RESEND_API_KEY and QUOTE_FROM_EMAIL the form
# shows a notice asking visitors to call or email instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Täby Bygg & Montage <offert@tbybygg.se>".
QUOTE_FROM_EMAIL=
# Recipient of quote requests. Defaults to the email address in src/content/site.ts.
QUOTE_TO_EMAIL=
